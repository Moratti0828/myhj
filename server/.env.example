# Copy to .env.local; never commit real secrets. Blank admin values disable bootstrap.
PORT=3000
SESSION_SECRET=change_this_session_secret
JSON_LIMIT=30mb

ADMIN_USERNAME=
ADMIN_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moyun_app
MYSQL_PASSWORD=
MYSQL_DATABASE=moyun_huajing

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_ENDPOINT=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image
SILICONFLOW_IMAGE_SIZE=1024x1024
SILICONFLOW_CAPTION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_PROMPT_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_PROMPT_REFINER=true
SILICONFLOW_PROMPT_TIMEOUT_MS=25000
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_MODEL=wan2.6-i2v-flash
DASHSCOPE_VIDEO_PROVIDER_POLL_INTERVAL_MS=15000

SILICONFLOW_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509

HOST=127.0.0.1
CORS_ORIGINS=
AI_DAILY_LIMIT=30

# Enable only when a local proxy returns Fake-IP DNS addresses for image hosts.
IMAGE_DNS_OVER_HTTPS=false
